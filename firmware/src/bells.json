{
  "v": 0,
  "name": "handbell",
  "bells": [
    {"id": "C5", "sound": "sounds/C5.wav"},
    {"id": "G5", "sound": "sounds/G5.wav"}
  ],
  "select": "cycle",
  "mode": "play",
  "ring": {"sens": "normal"},
  "detector": {},
  "controls": {
    "timing": {"double_ms": 300, "long_ms": 800, "very_long_ms": 5000},
    "key_velocity": 0.6,
    "play": {
      "ready": {"click": "next", "double": "previous", "long": "lock", "very_long": "maintenance"},
      "sounding": {"down": "damp", "very_long": "maintenance"}
    },
    "accessible": {
      "any": {"down": "ring", "very_long": "maintenance"}
    },
    "maintenance": {
      "any": {"click": "exit", "double": "toggle_accessible", "long": "volume", "very_long": "exit"}
    }
  },
  "audio": {
    "sample_rate": 22050,
    "voices": 2,
    "retrigger": "overlap",
    "damp_ms": 60,
    "level": {"min": 0.15, "max": 0.5, "curve": 0.7},
    "preview_level": 0.2,
    "mp3_decoders": 1,
    "volumes": [0.25, 0.5, 0.75, 1.0],
    "volume": 3
  },
  "power": {"keep_awake_s": 20, "settle_ms": 50, "wake_on_motion": true},
  "sleep": {
    "after_s": 120,
    "wake_mg": 250,
    "button_wakes": true,
    "announce_wake": true,
    "announce_power_on": true
  },
  "debug": {"events": true, "status_s": 5, "raw": false}
}
